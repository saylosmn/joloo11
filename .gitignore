android-sdk/
# Env files (never commit real secrets; only .env.example is tracked)
.env
backend/.env
frontend/.env

# Excel source workbook (kept out of repo; extracted images ARE committed)
backend/data/*.xlsx
.env.*
*.env
credentials.json
*.key
.credentials

# ...but the templates must stay tracked (negations have to come last to win).
!.env.example
!**/.env.example

