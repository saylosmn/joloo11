{
  "version": 2,
  "installCommand": "pip install -r backend/requirements.txt",
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "backend/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/frontend/(.*)",
      "dest": "backend/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.py"
    }
  ]
}
