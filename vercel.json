{
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.py"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "backend/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.py"
    }
  ]
}
