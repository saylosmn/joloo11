# ---- Backend environment (copy to backend/.env and fill in) ----

# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=zhd_exam

# Public base URL of this backend, e.g. https://api.example.mn
# Used for the QPay callback and to register the Telegram webhook.
PUBLIC_URL=

# ---- Google Sign-In ----
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID.
# Create one per platform you ship; the web client is required (Expo Go and web
# both use it). Only the CLIENT IDs go here - never the client secret.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# How long a login stays valid (days)
SESSION_DAYS=30

# ---- Telegram admin bot (optional; PRO activation + transfer approval) ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (only this id may run admin commands)
TELEGRAM_ADMIN_ID=
# Any random secret; used to verify incoming webhook calls
TELEGRAM_WEBHOOK_SECRET=change_me_to_something_random

# ---- QPay (PRO худалдан авалт) ----
# KKTT (QPay) -тай гэрээ байгуулаад авсан merchant мэдээлэл.
# Тест орчин: https://merchant-sandbox.qpay.mn/v2/
QPAY_HOST=https://merchant.qpay.mn/v2/
QPAY_USERNAME=
QPAY_PASSWORD=
# QPay-ээс өгсөн нэхэмжлэхийн код
QPAY_INVOICE_CODE=
# PRO-ийн үнэ (төгрөгөөр)
PRO_PRICE_MNT=19900
PRO_PRODUCT_NAME=ЗХД Шалгалт PRO
# PUBLIC_URL заавал тохируулсан байх ёстой — QPay callback үүн рүү ирнэ.

# Мөнгө орох дансыг тусгайлан заах (заавал биш).
# Хоосон орхивол merchant гэрээнд бүртгэлтэй үндсэн данс руу орно.
# Гурвуулаа бөглөгдсөн байх ёстой, данс нь QPay дээр бүртгэлтэй байх шаардлагатай.
QPAY_ACCOUNT_BANK_CODE=
QPAY_ACCOUNT_NUMBER=
QPAY_ACCOUNT_NAME=
QPAY_ACCOUNT_CURRENCY=MNT

# ---- Дансаар шилжүүлэх (QPay мерчант гэрээгүйгээр) ----
# Гурвуулаа бөглөвөл апп дээр «Дансаар шилжүүлэх» товч гарч ирнэ.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# IBAN (заавал биш) — өөр банкнаас шилжүүлэхэд хэрэгтэй.
BANK_IBAN=
# Банкны аппаасаа хадгалсан хувийн QR зураг. backend/data/ дотор байрлуулж,
# зөвхөн файлын нэрийг бичнэ (ж: my_qr.png). Хоосон бол QR харагдахгүй.
BANK_QR_FILE=
# Шилжүүлгийг баталгаажуулах товч TELEGRAM_ADMIN_ID руу очно —
# энэ горимд TELEGRAM_BOT_TOKEN болон TELEGRAM_ADMIN_ID заавал шаардлагатай.

# ---- Бусад ----
# Төлөгдөөгүй нэхэмжлэхийг хэдэн цагийн дараа цэвэрлэх вэ
INVOICE_TTL_HOURS=24
# CORS. "*" бол бүх эх сурвалж (credentials идэвхгүй). Тодорхой домэйнуудыг
# таслалаар зааглаж бичвэл credentials идэвхжинэ.
CORS_ORIGINS=*
# CORS_ORIGINS-ыг тодорхой домэйнээр хязгаарласан ч localhost-ын web build
# ажиллах боломжтой (Bearer токен ашигладаг тул эрсдэлгүй). Хаахыг хүсвэл 0.
ALLOW_LOCAL_ORIGINS=1

# ---- Зураг (сонголттой) ----
# Тохируулбал асуултын зураг энэ CDN-ээс тарна (ж: https://cdn.example.com/zhd-images).
# Хоосон бол /api/images-аас шууд явна.
IMAGE_CDN_BASE=
IMAGE_CACHE_SECONDS=31536000

# ---- Админ ----
# /api/admin/* хаягуудыг хамгаалах нууц түлхүүр. Хоосон бол
# TELEGRAM_WEBHOOK_SECRET ашиглана; хоёулаа хоосон бол админ хаяг хаалттай.
ADMIN_SECRET=
